# quantumcode LMS 환경변수 예시
#
# 실제 값이 든 .env 는 이 레포 안이 아니라 레포 밖(docker-compose.yml 옆)에 둔다.
# 소스가 통째로 웹루트에 마운트되므로, 레포 안에 .env 를 두면 브라우저로 그대로 읽힌다.
# docker compose 가 env_file 로 컨테이너에 주입하고 PHP 는 getenv() 로 읽는다.

# --- DB ---
DB_HOST=db
DB_NAME=quantumcode
DB_USER=quantumcode
DB_PASSWORD=여기에_DB_비밀번호
DB_ROOT_PASSWORD=여기에_root_비밀번호

# 공개 체험에서는 외부 메일·계정 변경·관리 쓰기를 차단한다.
DEMO_MODE=1
DEMO_PASSWORD=Portfolio123!
# HTTPS 배포에서는 1, localhost HTTP 검증에서는 0을 사용한다.
SESSION_COOKIE_SECURE=0

# --- 메일 (네이버 SMTP) : 회원가입 인증메일 발송 ---
MAIL_HOST=smtp.naver.com
MAIL_PORT=465
MAIL_USERNAME=여기에_네이버_아이디
MAIL_PASSWORD=여기에_네이버_비밀번호

# --- 구글 계정 : 구버전 가입 경로(account/usePhpMailer.php)에서만 사용 ---
GMAIL_USERNAME=여기에_구글_계정
GMAIL_APP_PASSWORD=여기에_구글_앱_비밀번호

# --- 카카오 로그인 ---
KAKAO_CLIENT_ID=여기에_카카오_REST_API_키
KAKAO_CLIENT_SECRET=여기에_카카오_client_secret
